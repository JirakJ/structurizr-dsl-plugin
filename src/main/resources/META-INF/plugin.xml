<idea-plugin>
  <id>com.jakubjirak.structurizr</id>
  <name>Structurizr DSL</name>
  <vendor email="jirak92@gmail.com" url="https://github.com/JirakJ/structurizr-dsl-plugin">Jakub Jirak</vendor>
  <description><![CDATA[<h2>Structurizr DSL — Architecture Diagrams as Code in Your IDE</h2>

<p>
  Full language support for Structurizr DSL — the industry-standard text-based language for defining
  C4 model architecture diagrams. Write, navigate, and preview your software architecture directly
  in your JetBrains IDE with all the features developers expect.
</p>

<h3>Editing and Authoring</h3>
<ul>
  <li><b>Syntax Highlighting</b> — Full colorization for keywords, strings, comments, identifiers, and variable substitutions</li>
  <li><b>Intelligent Code Completion</b> — Context-aware suggestions for elements, relationships, views, and properties, including smart relationship-target completion</li>
  <li><b>21 Live Templates</b> — Quick scaffolding for workspaces, systems, containers, components, views, groups, and more</li>
  <li><b>Color Preview</b> — Gutter swatches for hex colors in styles with a built-in color picker</li>
  <li><b>Code Folding and Formatting</b> — Collapse blocks and auto-format DSL files with configurable style</li>
</ul>

<h3>Navigation and Analysis</h3>
<ul>
  <li><b>Go to Definition</b> — Ctrl+Click to jump to element definitions</li>
  <li><b>Find Usages</b> — Alt+F7 to find all references to an element</li>
  <li><b>Structure View</b> — Hierarchical tree of workspace, model, views, and elements</li>
  <li><b>10 Code Inspections</b> — Detects errors like undefined references, duplicate identifiers, duplicate view keys, and invalid colors with quick fixes</li>
</ul>

<h3>Diagram Preview and Export</h3>
<ul>
  <li><b>Live Diagram Preview</b> — Real-time C4 diagram rendering as you type</li>
  <li><b>Split Editor</b> — Side-by-side DSL code and diagram view</li>
  <li><b>Multi-Format Export</b> — Export as SVG, PNG, PlantUML, or Mermaid</li>
  <li><b>Copy to Clipboard</b> — Copy diagrams in any format for instant sharing</li>
  <li><b>CLI Integration</b> — Auto-download and manage the Structurizr CLI</li>
</ul>

<h3>Requirements</h3>
<ul>
  <li>JetBrains IDE 2024.3+ (IntelliJ IDEA, WebStorm, PyCharm, GoLand, CLion, and all others)</li>
  <li>Windows, macOS, or Linux</li>
</ul>

<h3>Support</h3>
<ul>
  <li><a href="https://github.com/JirakJ/structurizr-dsl-plugin/issues">Issue Tracker</a></li>
  <li><a href="https://docs.structurizr.com/dsl/language">Structurizr DSL Language Reference</a></li>
  <li><a href="https://c4model.com/">C4 Model Documentation</a></li>
</ul>]]></description>
  <change-notes><![CDATA[
        <h3>2026.6.0 — Productivity Release</h3>
        <ul>
            <li><b>Critical fix: language engine restored</b> — A lexer table-unpacking defect made every file tokenize as one bad character, silently disabling the parser, inspections, navigation, structure view, and identifier completion. All language features now actually work as advertised</li>
            <li><b>Color Preview &amp; Picker</b> — Hex colors in element/relationship styles now show a swatch in the editor gutter; click it to change the color with the IDE color picker</li>
            <li><b>Smart Relationship Completion</b> (FR-306) — Completing after <code>-></code> now suggests only defined elements (excluding the source), ranked above keywords</li>
            <li><b>Duplicate View Key Inspection</b> (FR-507) — Detects views sharing the same key, which Structurizr rejects at export time</li>
            <li><b>4 New Live Templates</b> — <code>grp</code> (group), <code>props</code> (properties), <code>anim</code> (animation), <code>autolay</code> (autoLayout) — 21 templates total</li>
            <li><b>Fixed:</b> <code>colour</code> (British spelling) values are now validated by the invalid-color inspection</li>
            <li><b>Performance:</b> Duplicate identifier inspection no longer rescans the file for every element</li>
        </ul>

        <h3>2026.4.5 — Freemium Release</h3>
        <ul>
            <li><b>Freemium licensing</b> — Released with product-descriptor for JetBrains Marketplace freemium model (code: PSTRUCTURIZRDSL)</li>
        </ul>

        <h3>What's New</h3>
        <ul>
            <li><b>Syntax Highlighting</b> - Full colorization for keywords, strings, comments, identifiers, and variable substitutions in Structurizr DSL files</li>
            <li><b>Intelligent Code Completion</b> - Context-aware suggestions for elements, relationships, views, and all DSL keywords</li>
            <li><b>Navigation and Find Usages</b> - Go to definition, find usages, breadcrumbs, go-to-symbol, and line markers for quick code navigation</li>
            <li><b>9 Code Inspections</b> - Detects undefined references, unused elements, duplicate identifiers, empty blocks, missing properties, deprecated keywords, invalid colors, invalid contexts, and invalid relationships</li>
            <li><b>10 Live Templates</b> - Quick scaffolding for workspaces, persons, software systems, containers, components, relationships, and views</li>
            <li><b>Code Folding and Formatting</b> - Collapse DSL blocks and auto-format files with configurable code style settings</li>
            <li><b>Live Diagram Preview</b> - Real-time C4 diagram rendering with split editor view showing code and diagram side by side</li>
            <li><b>Multi-Format Export</b> - Export diagrams as SVG, PNG, PlantUML, or Mermaid with copy-to-clipboard support</li>
            <li><b>Structurizr CLI Integration</b> - Auto-download and manage the Structurizr CLI for rendering and validation</li>
            <li><b>Rename Refactoring</b> - Safely rename identifiers across all references in your DSL files</li>
        </ul>
    ]]></change-notes>
  <product-descriptor code="PSTRUCTURIZRDSL" release-date="20260609" release-version="20266" optional="true"/>
  <!-- Product and dependencies -->
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Language -->
    <fileType name="Structurizr DSL" implementationClass="com.jakubjirak.structurizr.language.StructurizrFileType" fieldName="INSTANCE" language="Structurizr" extensions="dsl" />
    <lang.parserDefinition language="Structurizr" implementationClass="com.jakubjirak.structurizr.language.parser.StructurizrParserDefinition" />
    <!-- Syntax Highlighting -->
    <lang.syntaxHighlighterFactory language="Structurizr" implementationClass="com.jakubjirak.structurizr.highlighting.StructurizrSyntaxHighlighterFactory" />
    <annotator language="Structurizr" implementationClass="com.jakubjirak.structurizr.highlighting.StructurizrAnnotator" />
    <colorSettingsPage implementationClass="com.jakubjirak.structurizr.highlighting.StructurizrColorSettingsPage" />
    <!-- Color schemes matching official Structurizr website appearance -->
    <additionalTextAttributes scheme="Default" file="colorSchemes/StructurizrDefault.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colorSchemes/StructurizrDarcula.xml"/>
    <!-- Code Completion -->
    <completion.contributor language="Structurizr" implementationClass="com.jakubjirak.structurizr.completion.StructurizrCompletionContributor" />
    <!-- Navigation -->
    <lang.findUsagesProvider language="Structurizr" implementationClass="com.jakubjirak.structurizr.navigation.StructurizrFindUsagesProvider" />
    <psi.referenceContributor language="Structurizr" implementation="com.jakubjirak.structurizr.navigation.StructurizrReferenceContributor"/>
    <psi.referenceContributor language="Structurizr" implementation="com.jakubjirak.structurizr.navigation.StructurizrIncludeReferenceContributor"/>
    <lang.psiStructureViewFactory language="Structurizr" implementationClass="com.jakubjirak.structurizr.navigation.StructurizrStructureViewFactory" />
    <breadcrumbsInfoProvider implementationClass="com.jakubjirak.structurizr.navigation.StructurizrBreadcrumbsProvider" />
    <!-- Code Folding -->
    <lang.foldingBuilder language="Structurizr" implementationClass="com.jakubjirak.structurizr.folding.StructurizrFoldingBuilder" />
    <!-- Formatting -->
    <lang.formatter language="Structurizr" implementationClass="com.jakubjirak.structurizr.formatting.StructurizrFormattingModelBuilder" />
    <codeStyleSettingsProvider implementationClass="com.jakubjirak.structurizr.formatting.StructurizrCodeStyleSettingsProvider" />
    <langCodeStyleSettingsProvider implementationClass="com.jakubjirak.structurizr.formatting.StructurizrLanguageCodeStyleSettingsProvider" />
    <!-- Inspections -->
    <localInspection language="Structurizr" shortName="StructurizrUndefinedReference" displayName="Undefined reference" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.UndefinedReferenceInspection" />
    <localInspection language="Structurizr" shortName="StructurizrUnusedElement" displayName="Unused element" groupName="Structurizr" enabledByDefault="true" level="WEAK WARNING" implementationClass="com.jakubjirak.structurizr.inspections.UnusedElementInspection" />
    <localInspection language="Structurizr" shortName="StructurizrDuplicateIdentifier" displayName="Duplicate identifier" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.DuplicateIdentifierInspection" />
    <localInspection language="Structurizr" shortName="StructurizrEmptyBlock" displayName="Empty block" groupName="Structurizr" enabledByDefault="true" level="WEAK WARNING" implementationClass="com.jakubjirak.structurizr.inspections.EmptyBlockInspection" />
    <localInspection language="Structurizr" shortName="StructurizrMissingRequiredProperty" displayName="Missing required property" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.MissingRequiredPropertyInspection" />
    <localInspection language="Structurizr" shortName="StructurizrDeprecatedKeyword" displayName="Deprecated keyword" groupName="Structurizr" enabledByDefault="true" level="WARNING" implementationClass="com.jakubjirak.structurizr.inspections.DeprecatedKeywordInspection" />
    <localInspection language="Structurizr" shortName="StructurizrInvalidColor" displayName="Invalid color value" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.InvalidColorInspection" />
    <localInspection language="Structurizr" shortName="StructurizrInvalidContext" displayName="Invalid element context" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.InvalidContextInspection" />
    <localInspection language="Structurizr" shortName="StructurizrInvalidRelationship" displayName="Invalid relationship" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.InvalidRelationshipInspection" />
    <localInspection language="Structurizr" shortName="StructurizrDuplicateViewKey" displayName="Duplicate view key" groupName="Structurizr" enabledByDefault="true" level="ERROR" implementationClass="com.jakubjirak.structurizr.inspections.DuplicateViewKeyInspection" />
    <!-- Color preview in gutter + color picker for style properties -->
    <colorProvider implementation="com.jakubjirak.structurizr.highlighting.StructurizrColorProvider" />
    <!-- Commenter -->
    <lang.commenter language="Structurizr" implementationClass="com.jakubjirak.structurizr.language.StructurizrCommenter" />
    <!-- Brace Matcher -->
    <lang.braceMatcher language="Structurizr" implementationClass="com.jakubjirak.structurizr.language.StructurizrBraceMatcher" />
    <!-- Refactoring -->
    <lang.namesValidator language="Structurizr" implementationClass="com.jakubjirak.structurizr.refactoring.StructurizrNamesValidator"/>
    <lang.refactoringSupport language="Structurizr" implementationClass="com.jakubjirak.structurizr.refactoring.StructurizrRefactoringSupportProvider"/>
    <!-- Quote Handler -->
    <lang.quoteHandler language="Structurizr" implementationClass="com.jakubjirak.structurizr.language.StructurizrQuoteHandler" />
    <!-- Settings -->
    <applicationConfigurable parentId="tools" instance="com.jakubjirak.structurizr.settings.StructurizrSettingsConfigurable" id="com.jakubjirak.structurizr.settings" displayName="Structurizr DSL" />
    <applicationService serviceImplementation="com.jakubjirak.structurizr.settings.StructurizrSettings" />
    <!-- Licensing -->
    <applicationService serviceImplementation="com.jakubjirak.structurizr.licensing.FreemiumGate" />
    <!-- Project Settings -->
    <projectConfigurable parentId="com.jakubjirak.structurizr.settings" instance="com.jakubjirak.structurizr.settings.StructurizrProjectSettingsConfigurable" id="com.jakubjirak.structurizr.projectSettings" displayName="Project Settings" />
    <projectService serviceImplementation="com.jakubjirak.structurizr.settings.StructurizrProjectSettings" />
    <!-- File Templates -->
    <internalFileTemplate name="Structurizr Workspace" />
    <!-- Notifications -->
    <notificationGroup id="Structurizr DSL" displayType="BALLOON" />
    <!-- Documentation -->
    <lang.documentationProvider language="Structurizr" implementationClass="com.jakubjirak.structurizr.documentation.StructurizrDocumentationProvider" />
    <!-- Live Templates -->
    <defaultLiveTemplates>/liveTemplates/Structurizr</defaultLiveTemplates>
    <liveTemplateContext contextId="STRUCTURIZR_DSL" implementation="com.jakubjirak.structurizr.language.StructurizrLiveTemplateContext"/>
    <!-- Line Marker (for navigation) -->
    <codeInsight.lineMarkerProvider language="Structurizr" implementationClass="com.jakubjirak.structurizr.navigation.StructurizrLineMarkerProvider" />
    <!-- Go to Symbol -->
    <gotoSymbolContributor implementation="com.jakubjirak.structurizr.navigation.StructurizrGotoSymbolContributor"/>
    <!-- Preview Services -->
    <projectService serviceImplementation="com.jakubjirak.structurizr.preview.DiagramRendererService" />
    <applicationService serviceImplementation="com.jakubjirak.structurizr.preview.StructurizrCliService" />
    <!-- Export Service -->
    <projectService serviceImplementation="com.jakubjirak.structurizr.export.StructurizrExportService" />
    <!-- Split Editor with Preview -->
    <fileEditorProvider implementationClass="com.jakubjirak.structurizr.preview.StructurizrSplitEditorProvider" />
    <!-- Preview Tool Window -->
    <toolWindow id="Structurizr Preview" anchor="right" secondary="true" icon="/icons/structurizr.svg" factoryClass="com.jakubjirak.structurizr.preview.StructurizrPreviewToolWindowFactory" />
  
        <notificationGroup id="Structurizr DSL Feedback" displayType="BALLOON"/>
        <projectActivity implementation="com.jakubjirak.structurizr.feedback.FeedbackNotifier"/>
    </extensions>
  <actions>
    <!-- New File Action -->
    <action id="Structurizr.NewFile" class="com.jakubjirak.structurizr.actions.NewStructurizrFileAction" text="Structurizr DSL File" description="Create a new Structurizr DSL file" icon="/icons/structurizr.svg">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile" />
    </action>
    <!-- Refresh Preview Action -->
    <action id="Structurizr.RefreshPreview" class="com.jakubjirak.structurizr.actions.RefreshPreviewAction" text="Refresh Structurizr Preview" description="Refresh the diagram preview" icon="AllIcons.Actions.Refresh">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift R" />
    </action>
    <!-- Export Diagram Action -->
    <action id="Structurizr.ExportDiagram" class="com.jakubjirak.structurizr.actions.ExportDiagramAction" text="Export Structurizr Diagram..." description="Export diagram to various formats" icon="AllIcons.ToolbarDecorator.Export">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>
    <!-- Quick Export Actions -->
    <action id="Structurizr.ExportSvg" class="com.jakubjirak.structurizr.actions.QuickExportSvgAction" text="Export as SVG..." description="Quick export to SVG format" />
    <action id="Structurizr.ExportPng" class="com.jakubjirak.structurizr.actions.QuickExportPngAction" text="Export as PNG..." description="Quick export to PNG format" />
    <action id="Structurizr.ExportPlantUml" class="com.jakubjirak.structurizr.actions.QuickExportPlantUmlAction" text="Export as PlantUML..." description="Quick export to PlantUML format" />
    <!-- Copy to Clipboard Actions -->
    <action id="Structurizr.CopyAsSvg" class="com.jakubjirak.structurizr.actions.CopyAsSvgAction" text="Copy as SVG" description="Copy diagram as SVG to clipboard" />
    <action id="Structurizr.CopyAsPlantUml" class="com.jakubjirak.structurizr.actions.CopyAsPlantUmlAction" text="Copy as PlantUML" description="Copy diagram as PlantUML to clipboard" />
    <action id="Structurizr.CopyAsMermaid" class="com.jakubjirak.structurizr.actions.CopyAsMermaidAction" text="Copy as Mermaid" description="Copy diagram as Mermaid to clipboard" />
    <action id="Structurizr.CopyAsImage" class="com.jakubjirak.structurizr.actions.CopyAsImageAction" text="Copy as Image" description="Copy diagram as image to clipboard" />
    <!-- Export Submenu -->
    <group id="Structurizr.ExportMenu" text="Export" popup="true" icon="AllIcons.ToolbarDecorator.Export">
      <reference ref="Structurizr.ExportDiagram" />
      <separator />
      <reference ref="Structurizr.ExportSvg" />
      <reference ref="Structurizr.ExportPng" />
      <reference ref="Structurizr.ExportPlantUml" />
    </group>
    <!-- Copy Submenu -->
    <group id="Structurizr.CopyMenu" text="Copy Diagram" popup="true" icon="AllIcons.Actions.Copy">
      <reference ref="Structurizr.CopyAsSvg" />
      <reference ref="Structurizr.CopyAsPlantUml" />
      <reference ref="Structurizr.CopyAsMermaid" />
      <separator />
      <reference ref="Structurizr.CopyAsImage" />
    </group>
    <!-- Menu Group -->
    <group id="Structurizr.MainMenu" text="Structurizr" popup="true">
      <reference ref="Structurizr.NewFile" />
      <separator />
      <reference ref="Structurizr.RefreshPreview" />
      <separator />
      <reference ref="Structurizr.ExportMenu" />
      <reference ref="Structurizr.CopyMenu" />
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </group>
    <!-- Editor Context Menu -->
    <group id="Structurizr.EditorContextMenu">
      <reference ref="Structurizr.RefreshPreview" />
      <reference ref="Structurizr.ExportMenu" />
      <reference ref="Structurizr.CopyMenu" />
      <add-to-group group-id="EditorPopupMenu" anchor="before" relative-to-action="$Cut" />
    </group>
  </actions>
</idea-plugin>
